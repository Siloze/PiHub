{
  "id": "mlx",
  "kind": "provider",
  "name": "MLX LM",
  "icon": "cube.transparent",
  "color": "cyan",
  "description": "Serveur MLX LM · modèles safetensors",
  "executables": [
    "mlx_lm.server",
    "{root}/env/mlx/bin/mlx_lm.server"
  ],
  "command": [
    "{executable}",
    "--model",
    "{model}",
    "--host",
    "{host}",
    "--port",
    "{port}",
    "--temp",
    "{temperature}",
    "--top-p",
    "{top_p}",
    "--max-tokens",
    "{max_tokens}",
    "--chat-template-args",
    "{template_args}"
  ],
  "fields": [
    {
      "key": "temperature",
      "label": "Température par défaut",
      "group": "Échantillonnage",
      "type": "slider",
      "default": "0.7",
      "min": 0,
      "max": 2,
      "step": 0.05
    },
    {
      "key": "top_p",
      "label": "Top P",
      "group": "Échantillonnage",
      "type": "slider",
      "default": "0.95",
      "min": 0.05,
      "max": 1,
      "step": 0.05
    },
    {
      "key": "max_tokens",
      "label": "Limite de sortie (tokens)",
      "group": "Échantillonnage",
      "type": "number",
      "default": "8192"
    },
    {
      "key": "template_args",
      "label": "Arguments du template (JSON · enable_thinking)",
      "group": "Réflexion",
      "type": "text",
      "default": "{\"enable_thinking\":true}"
    },
    {
      "key": "host",
      "label": "Adresse d’écoute",
      "group": "Réseau",
      "type": "text",
      "default": "127.0.0.1"
    },
    {
      "key": "port",
      "label": "Port HTTP",
      "group": "Réseau",
      "type": "number",
      "default": "18002"
    },
    {
      "key": "key_env",
      "label": "Variable de clé API",
      "group": "Réseau",
      "type": "text",
      "default": ""
    },
    {
      "key": "model",
      "label": "Modèle / chemin",
      "group": "Modèle",
      "type": "model",
      "default": ""
    },
    {
      "key": "executable",
      "label": "Chemin de l’exécutable",
      "group": "Avancé",
      "type": "file",
      "default": ""
    },
    {
      "key": "extra_args",
      "label": "Arguments supplémentaires (JSON)",
      "group": "Avancé",
      "type": "text",
      "default": "[]"
    }
  ],
  "health": "/v1/models",
  "model_format": "mlx",
  "process_signatures": [
    "mlx_lm.server"
  ],
  "handlers": {
    "status": "handler.py:_hook_status",
    "test": "handler.py:_hook_test",
    "start": "handler.py:_hook_start",
    "stop": "handler.py:_hook_stop",
    "restart": "handler.py:_hook_restart",
    "preview": "handler.py:_hook_preview",
    "adopt": "handler.py:_hook_adopt",
    "logs": "handler.py:_hook_logs"
  },
  "install": {
    "summary": "Safetensors · environnement Python isolé",
    "repository": "https://github.com/ml-explore/mlx-lm.git",
    "revision": "06e03f7ce7c059ad105483a9dded0bb338cbaf53",
    "verification": "source-reviewed",
    "allow_revision": true,
    "prerequisites": [
      "git",
      "uv"
    ],
    "executable": "{package}/venv/bin/mlx_lm.server",
    "steps": [
      {
        "label": "Initialiser le dépôt isolé",
        "argv": [
          "git",
          "init",
          "{package}/source"
        ]
      },
      {
        "label": "Déclarer le dépôt officiel",
        "argv": [
          "git",
          "-C",
          "{package}/source",
          "remote",
          "add",
          "origin",
          "{repository}"
        ]
      },
      {
        "label": "Télécharger la révision sélectionnée",
        "argv": [
          "git",
          "-C",
          "{package}/source",
          "fetch",
          "--depth",
          "1",
          "origin",
          "{revision}"
        ]
      },
      {
        "label": "Extraire la révision",
        "argv": [
          "git",
          "-C",
          "{package}/source",
          "checkout",
          "--detach",
          "FETCH_HEAD"
        ]
      },
      {
        "label": "Créer Python 3.11 isolé",
        "argv": [
          "uv",
          "venv",
          "--python",
          "3.11",
          "{package}/venv"
        ]
      },
      {
        "label": "Installer MLX LM",
        "argv": [
          "uv",
          "pip",
          "install",
          "--python",
          "{package}/venv/bin/python",
          "{package}/source"
        ]
      }
    ]
  }
}
