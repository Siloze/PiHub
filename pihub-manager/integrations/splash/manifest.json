{
  "id": "splash",
  "kind": "provider",
  "name": "Splash",
  "icon": "sparkles",
  "color": "violet",
  "description": "Inférence Apple Silicon · MLX, Metal et DFlash2",
  "executables": [
    "{root}/engine/splash-1.3.2/splash-1.3.2-arm64-macos26/python/bin/python3"
  ],
  "command": [
    "{executable}",
    "-m",
    "install.launcher",
    "serve",
    "--model",
    "{model}",
    "--host",
    "{host}",
    "--port",
    "{port}",
    "--max-context",
    "{context}",
    "--max-memory",
    "{memory}G",
    "--kv-format",
    "{kv}",
    "--default-reasoning-effort",
    "{thinking}",
    "--idle-release",
    "{idle}",
    "--max-cache-disk",
    "{disk}G"
  ],
  "fields": [
    {
      "key": "host",
      "label": "Adresse d’écoute",
      "group": "Réseau",
      "type": "text",
      "default": "127.0.0.1"
    },
    {
      "key": "port",
      "label": "Port HTTP",
      "group": "Réseau",
      "type": "number",
      "default": "18000"
    },
    {
      "key": "key_env",
      "label": "Variable de clé API",
      "group": "Réseau",
      "type": "text",
      "default": ""
    },
    {
      "key": "model",
      "label": "Modèle / chemin",
      "group": "Modèle",
      "type": "model",
      "default": "mlx-community/Qwen3.6-35B-A3B-4bit"
    },
    {
      "key": "context",
      "label": "Contexte (tokens)",
      "group": "Modèle",
      "type": "number",
      "default": "196608"
    },
    {
      "key": "thinking",
      "label": "Effort de réflexion",
      "group": "Modèle",
      "type": "select",
      "default": "none",
      "options": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    {
      "key": "memory",
      "label": "Budget mémoire (Go)",
      "group": "Mémoire",
      "type": "slider",
      "default": "30",
      "min": 4,
      "max": 128,
      "step": 1
    },
    {
      "key": "kv",
      "label": "Cache KV",
      "group": "Mémoire",
      "type": "select",
      "default": "int8",
      "options": [
        "int8",
        "bf16"
      ]
    },
    {
      "key": "disk",
      "label": "Cache SSD (Go)",
      "group": "Mémoire",
      "type": "slider",
      "default": "0",
      "min": 0,
      "max": 128,
      "step": 1
    },
    {
      "key": "idle",
      "label": "Libération au repos",
      "group": "Mémoire",
      "type": "text",
      "default": "off"
    },
    {
      "key": "offline",
      "label": "Hors ligne",
      "group": "Options",
      "type": "toggle",
      "default": "true"
    },
    {
      "key": "language_only",
      "label": "Texte uniquement",
      "group": "Options",
      "type": "toggle",
      "default": "true"
    },
    {
      "key": "webui",
      "label": "Interface chat Splash",
      "group": "Options",
      "type": "toggle",
      "default": "false"
    },
    {
      "key": "ane",
      "label": "Neural Engine",
      "group": "Options",
      "type": "toggle",
      "default": "true"
    },
    {
      "key": "executable",
      "label": "Chemin de l’exécutable",
      "group": "Avancé",
      "type": "file",
      "default": ""
    },
    {
      "key": "extra_args",
      "label": "Arguments supplémentaires (JSON)",
      "group": "Avancé",
      "type": "text",
      "default": "[]"
    }
  ],
  "env": {
    "PYTHONPATH": "{root}/engine/splash-1.3.2/splash-1.3.2-arm64-macos26",
    "HF_HOME": "{root}/models/huggingface",
    "SPLASH_DATA_DIR": "{root}/models/splash-runtime"
  },
  "flags": {
    "offline": {
      "true": [
        "--offline"
      ]
    },
    "language_only": {
      "true": [
        "--language-only"
      ]
    },
    "webui": {
      "false": [
        "--no-webui"
      ]
    },
    "ane": {
      "false": [
        "--disable-ane"
      ]
    }
  },
  "health": "/status",
  "model_format": "mlx",
  "process_signatures": [
    "server.server"
  ],
  "server_key_env": "SPLASH_API_KEY",
  "handlers": {
    "status": "handler.py:status",
    "test": "handler.py:_hook_test",
    "start": "handler.py:_hook_start",
    "stop": "handler.py:_hook_stop",
    "restart": "handler.py:_hook_restart",
    "preview": "handler.py:_hook_preview",
    "adopt": "handler.py:_hook_adopt",
    "logs": "handler.py:_hook_logs"
  },
  "log_paths": [
    "{root}/profile/logs/splash.log"
  ],
  "install": {
    "summary": "MLX + Metal · distribution autonome Apple Silicon",
    "repository": "https://github.com/incoai/splash",
    "revision": "1.3.2",
    "commit": "5d54762c7cc7aba55c252a1ba538fc517134166a",
    "verification": "runtime-tested",
    "min_macos": 26,
    "prerequisites": [],
    "executable": "{package}/splash-1.3.2-arm64-macos26/python/bin/python3",
    "runtime_env": {
      "PYTHONPATH": "{package}/splash-1.3.2-arm64-macos26"
    },
    "steps": [
      {
        "label": "Télécharger et vérifier Splash 1.3.2 (SHA-256)",
        "download": "https://github.com/incoai/splash/releases/download/1.3.2/splash-1.3.2-arm64-macos26.tar.gz",
        "sha256": "c3deb1dd971461ffafcf6b82c318789d6698b22aa865e490a11a0ed943686c0b"
      }
    ]
  }
}
