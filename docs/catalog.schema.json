{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PiHub manifest.install",
  "type": "object",
  "properties": {
    "summary": {"type": "string"},
    "repository": {"type": "string"},
    "revision": {"type": "string"},
    "commit": {"type": "string"},
    "verification": {"enum": ["source-reviewed", "runtime-tested", "unverified"]},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "executable": {"type": "string"},
    "allow_revision": {"type": "boolean"},
    "min_macos": {"type": "integer"},
    "env": {"type": "object", "additionalProperties": {"type": "string"}},
    "runtime_env": {"type": "object", "additionalProperties": {"type": "string"}},
    "steps": {"type": "array", "items": {
      "type": "object", "required": ["label"],
      "properties": {
        "label": {"type": "string"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cwd": {"type": "string"},
        "download": {"type": "string", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "oneOf": [{"required": ["argv"]}, {"required": ["download", "sha256"]}]
    }}
  }
}
